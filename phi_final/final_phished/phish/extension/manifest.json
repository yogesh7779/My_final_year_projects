{
  "manifest_version": 3,
  "name": "URL Phishing Guard - Quick Checker",
  "description": "Detects possible phishing URLs on hover/click and asks before navigation.",
  "version": "1.0.0",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Phishing Guard"
  },

  "icons": {
    "128": "icons/128.png",
    "48": "icons/48.png",
    "32": "icons/32.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
